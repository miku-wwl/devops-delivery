# Pinned versions for the v2 enterprise simulation (latest releases checked on GitHub on 2026-11-07).
# Tools already installed in the devops-lab WSL distro (kind, kubectl, helm, k6, ...) keep the
# versions in automation/lab/versions.env. Entries are added as each phase starts using a component.

# E0 platform baseline
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
REGISTRY_IMAGE=registry:3.1.2
CLOUD_PROVIDER_KIND_IMAGE=registry.k8s.io/cloud-provider-kind/cloud-controller-manager:v0.12.0
METRICS_SERVER_VERSION=v0.9.1

# E2 service mesh
# Istio 1.31.4 (2026-11-06) instead of 1.31.3: fixes GHSA-rr2c-p22p-6r9r (High) in ambient
# mode (port-level STRICT PeerAuthentication skipped). Charts moved to blob.istio.io.
ISTIO_VERSION=1.31.4
ISTIO_CHART_REPO=https://blob.istio.io/istio-release/charts
# Gateway API v1.6.3 experimental channel: Istio 1.31 is built against v1.6.0
# (go.mod sigs.k8s.io/gateway-api v1.6.0); experimental adds HTTPRoute retries
GATEWAY_API_VERSION=v1.6.3
GATEWAY_API_CRDS_SHA256=72f549ff57416e2e1085c5be1718f5f86108aa75ac39b4bc27c1c7aef1497127
# E4: event-driven autoscaling (chart = app version)
KEDA_CHART_VERSION=2.21.0
# E5: admission policy (chart 3.9.2 = Kyverno v1.19.2, images from ghcr.io)
KYVERNO_CHART_VERSION=3.9.2
# E5: secret store and sync (OpenBao v2.7.2; External Secrets v2.14.0)
OPENBAO_CHART_VERSION=0.30.7
EXTERNAL_SECRETS_CHART_VERSION=2.14.0
# E7: backups outside the cluster (Garage v2.5.0, 2026-10-24) and Velero
GARAGE_IMAGE=dxflrs/garage:v2.5.0
CNPG_PLUGIN_VERSION=1.30.1
# E10 (chapter 11): kwokctl, a control plane with simulated nodes and pods (platform/kwok/install.sh)
KWOK_VERSION=v0.8.0
