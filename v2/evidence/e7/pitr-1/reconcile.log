# pitr-1 follow-up: reconcile restored rows with the events that happened after the target (2026-11-09T15:11:25Z)
select o.id, o.status, e.subject, e.created_at as event_at from orders o join outbox e on e.payload->>'order_id' = o.id::text where o.status = 'PENDING' and e.subject = 'orders.confirmed' and e.created_at > timestamptz '2026-11-09 15:07:19.214692+00';
