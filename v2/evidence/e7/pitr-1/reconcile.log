update orders o set status = 'CONFIRMED', updated_at = e.created_at from outbox e where e.payload->>'order_id' = o.id::text and o.status = 'PENDING' and e.subject = 'orders.confirmed' and e.created_at > timestamptz '2026-11-09 15:07:19.214692+00';
