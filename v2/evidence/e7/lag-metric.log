# What the replication metrics say about a replica whose WAL stream is cut (one replica only: with ANY 1
# synchronous replication the other one keeps commits flowing). Chain E7LAG on the primary's node, removed at the end.
$ P=$(kubectl -n data get cluster pg-main -o jsonpath='{.status.currentPrimary}'); PN=$(kubectl -n data get pod $P -o jsonpath='{.spec.nodeName}'); R=$(kubectl -n data get pods -l cnpg.io/cluster=pg-main,cnpg.io/instanceRole=replica -o jsonpath='{.items[0].metadata.name}'); echo "primary $P on $PN, replica cut off: $R"
primary pg-main-1 on ent-worker, replica cut off: pg-main-2

$ PIP=$(kubectl -n data get pod $P -o jsonpath='{.status.podIP}'); RIP=$(kubectl -n data get pod $R -o jsonpath='{.status.podIP}'); docker exec $PN sh -c "iptables -N E7LAG && iptables -A E7LAG -s $RIP -d $PIP -p tcp --dport 5432 -j DROP && iptables -A E7LAG -s $PIP -d $RIP -p tcp --sport 5432 -j DROP && iptables -I FORWARD 1 -j E7LAG" 2>&1 | grep -v legacy; date -u +%T
23:37:18

$ for i in 1 2 3 4; do sleep 30; echo "$(date -u +%T) $R: lag=$(bash v2/experiments/e4/promq.sh $(date +%s) "max(cnpg_pg_replication_lag{pod=\"$R\"})" | awk '{print $NF}') wal_receiver_up=$(bash v2/experiments/e4/promq.sh $(date +%s) "max(cnpg_pg_replication_is_wal_receiver_up{pod=\"$R\"})" | awk '{print $NF}') | primary: streaming replicas=$(bash v2/experiments/e4/promq.sh $(date +%s) "max(cnpg_pg_replication_streaming_replicas{pod=\"$P\"})" | awk '{print $NF}') | cluster: $(kubectl -n data get cluster pg-main -o jsonpath='{.status.phase}') | alert: $(kubectl get --raw /api/v1/namespaces/monitoring/services/kps-prometheus:9090/proxy/api/v1/alerts | jq -r --arg r $R '[.data.alerts[] | select(.labels.alertname == "PostgresReplicaNotStreaming" and .labels.pod == $r) | .state] | join(",")')"; done
