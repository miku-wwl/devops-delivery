# 2. OpenBao's new readiness probe (StatefulSet updateStrategy OnDelete): restart it and look at it while it is sealed
$ for i in $(seq 1 20); do p=$(kubectl -n secrets get sts openbao -o jsonpath='{.spec.template.spec.containers[0].readinessProbe.httpGet.path}'); [ -n "$p" ] && break; sleep 5; done; echo "template probe: $p"
