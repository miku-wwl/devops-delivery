$ kubectl -n storefront create configmap reach-probe --from-file=reach_probe.py=v2/experiments/e5/reach_probe.py --dry-run=client -o yaml | kubectl apply -f - >/dev/null; kubectl -n storefront run hdr-probe --image=$(kubectl -n storefront get deploy catalog -o jsonpath='{.spec.template.spec.containers[0].image}') --restart=Never --overrides='{"spec":{"securityContext":{"runAsNonRoot":true,"runAsUser":10001,"seccompProfile":{"type":"RuntimeDefault"}},"containers":[{"name":"hdr-probe","image":"'$(kubectl -n storefront get deploy catalog -o jsonpath='{.spec.template.spec.containers[0].image}')'","command":["python","-c","import time; time.sleep(600)"],"securityContext":{"allowPrivilegeEscalation":false,"capabilities":{"drop":["ALL"]},"readOnlyRootFilesystem":true},"volumeMounts":[{"name":"p","mountPath":"/probe"}]}],"volumes":[{"name":"p","configMap":{"name":"reach-probe"}}]}}' >/dev/null; kubectl -n storefront wait --for=condition=Ready pod/hdr-probe --timeout=90s >/dev/null; echo ready
ready

