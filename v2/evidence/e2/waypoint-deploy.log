$ kubectl -n argocd annotate application platform-root argocd.argoproj.io/refresh=normal --overwrite >/dev/null; kubectl -n argocd annotate applications -l storefront/env=prod argocd.argoproj.io/refresh=normal --overwrite >/dev/null

$ for i in $(seq 90); do [ "$(kubectl -n storefront get deploy waypoint -o jsonpath={.status.readyReplicas} 2>/dev/null)" = 1 ] && [ "$(kubectl get ns storefront -o jsonpath="{.metadata.labels.istio\.io/use-waypoint}")" = waypoint ] && break; sleep 5; done

