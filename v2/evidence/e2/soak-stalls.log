# every stall the watchdog reported since the new pods started (threshold 250 ms)
$ for p in $(kubectl -n storefront get pods -l app.kubernetes.io/part-of=storefront -o name); do kubectl -n storefront logs $p -c app 2>/dev/null | grep "event loop blocked" | jq -c "{ts, service, blocked_ms, cpu_ms, loop_thread_cpu_ms, runqueue_ms, top: (.stack | split(\"\n\") | map(select(test(\"File\"))) | .[-2:] | join(\" <- \"))}"; done | sort
[exit 1]

# loop wake-ups later than 50 ms / 100 ms / 250 ms during the soak, per service
$ for le in 0.05 0.1 0.25; do kubectl get --raw "/api/v1/namespaces/monitoring/services/kps-prometheus:9090/proxy/api/v1/query?query=$(jq -rn --arg s "sum by (service) (increase(event_loop_lag_seconds_count{namespace=\"storefront\"}[16m])) - sum by (service) (increase(event_loop_lag_seconds_bucket{namespace=\"storefront\",le=\"$le\"}[16m]))" "\$s|@uri")" | jq -r --arg le $le ".data.result[] | \"lag > \(\$le) s: \(.metric.service) \(.value[1] | tonumber | round)\""; done | sort
