$ GW=$(kubectl -n storefront get svc gateway -o jsonpath="{.status.loadBalancer.ingress[0].ip}"); echo "gateway LoadBalancer: $GW"
gateway LoadBalancer: 172.20.0.12

$ curl -s -D - -o /tmp/order.json "http://$GW:8080/api/orders" -H "Content-Type: application/json" -H "Idempotency-Key: e1-trace-demo-0001" -H "X-Request-ID: e1-trace-demo" -d "{\"customer_id\":\"c-42\",\"items\":[{\"product_id\":\"sku-007\",\"qty\":2},{\"product_id\":\"sku-011\",\"qty\":1}]}" | grep -iE "^HTTP|x-request-id"; cat /tmp/order.json; echo
HTTP/1.1 201 Created
x-request-id: e1-trace-demo
{"id":"f9c9a183-7f61-4786-b175-903dcfc7604b","status":"CONFIRMED","total_cents":4625}

$ ORDER=$(jq -r .id /tmp/order.json); sleep 3; curl -s "http://$GW:8080/api/orders/$ORDER" | jq -c "{id, status, total_cents, items}"
{"id":"f9c9a183-7f61-4786-b175-903dcfc7604b","status":"CONFIRMED","total_cents":4625,"items":[{"qty":2,"product_id":"sku-007"},{"qty":1,"product_id":"sku-011"}]}

# the same request again: idempotent replay, no second order
$ curl -s -D - -o /dev/null "http://$GW:8080/api/orders" -H "Content-Type: application/json" -H "Idempotency-Key: e1-trace-demo-0001" -d "{\"customer_id\":\"c-42\",\"items\":[{\"product_id\":\"sku-007\",\"qty\":2},{\"product_id\":\"sku-011\",\"qty\":1}]}" | grep -iE "^HTTP|idempotent"
HTTP/1.1 200 OK
idempotent-replayed: true

$ kubectl -n storefront exec deploy/notifier -- python -c "import urllib.request,json; print([n for n in json.load(urllib.request.urlopen(\"http://localhost:8080/notifications/recent?limit=5\")) if n[\"order_id\"]==\"$ORDER\"])"
