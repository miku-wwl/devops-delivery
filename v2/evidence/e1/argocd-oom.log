# Same trigger as before: hard refresh of every application at once; sample the memory peak
$ before=$(docker exec ent-worker2 cat /sys/fs/cgroup/memory.events | awk "/^oom_kill /{print \$2}"); echo "node oom_kill counter before: $before"
node oom_kill counter before: 9

$ kubectl -n argocd annotate applications --all argocd.argoproj.io/refresh=hard --overwrite >/dev/null

$ peak=0; for i in $(seq 36); do m=$(kubectl -n argocd top pod argocd-application-controller-0 --no-headers 2>/dev/null | awk "{print \$3+0}"); [ -n "$m" ] && [ "$m" -gt "$peak" ] && peak=$m; sleep 5; done; echo "controller memory peak over 3 min (metrics-server, 15 s resolution): ${peak}Mi"
controller memory peak over 3 min (metrics-server, 15 s resolution): 429Mi

$ after=$(docker exec ent-worker2 cat /sys/fs/cgroup/memory.events | awk "/^oom_kill /{print \$2}"); echo "node oom_kill counter after: $after"
node oom_kill counter after: 9

$ kubectl -n argocd get pod argocd-application-controller-0 -o jsonpath="restarts={.status.containerStatuses[0].restartCount}"; echo
restarts=0

