$ t0=$(date +%s.%N); kubectl -n e0-smoke expose deploy echo --name echo --type LoadBalancer --port 80 --target-port 8080 >/dev/null; while [ -z "$(kubectl -n e0-smoke get svc echo -o jsonpath="{.status.loadBalancer.ingress[0].ip}")" ]; do sleep 0.2; done; ip=$(kubectl -n e0-smoke get svc echo -o jsonpath="{.status.loadBalancer.ingress[0].ip}"); printf "LB IP %s assigned after %.1f s\n" "$ip" "$(echo "$(date +%s.%N) - $t0" | bc)"
