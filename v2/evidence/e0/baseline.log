# what kubelet really runs with (configz is the effective configuration, after flags)
$ for n in ent-control-plane ent-worker; do echo "== $n"; kubectl get --raw /api/v1/nodes/$n/proxy/configz | jq -c ".kubeletconfig | {cgroupRoot, kubeReserved, systemReserved, evictionHard, evictionMinimumReclaim, enforceNodeAllocatable, maxPods, failSwapOn, memorySwap}"; done
