# memory.max at each level: node (Docker limit) > kubelet/kubepods (capacity - reserved) > pod
$ docker exec ent-worker sh -c "for d in . kubelet.slice kubelet.slice/kubelet-kubepods.slice kubelet.slice/kubelet-kubepods.slice/kubelet-kubepods-burstable.slice kubelet.slice/kubelet-kubepods.slice/kubelet-kubepods-besteffort.slice; do [ -d /sys/fs/cgroup/\$d ] && printf \"%-75s memory.max=%s cpu.weight=%s\n\" \$d \$(cat /sys/fs/cgroup/\$d/memory.max) \$(cat /sys/fs/cgroup/\$d/cpu.weight 2>/dev/null || echo -); done"
.                                                                           memory.max=3221225472 cpu.weight=100
kubelet.slice                                                               memory.max=max cpu.weight=100
kubelet.slice/kubelet-kubepods.slice                                        memory.max=16133476352 cpu.weight=147
kubelet.slice/kubelet-kubepods.slice/kubelet-kubepods-burstable.slice       memory.max=max cpu.weight=9
kubelet.slice/kubelet-kubepods.slice/kubelet-kubepods-besteffort.slice      memory.max=max cpu.weight=1

# OOM priority (oom_score_adj): node agents are protected, pods are ranked by QoS class
$ docker exec ent-worker sh -c "for p in \$(pgrep -x systemd) \$(pgrep -x containerd) \$(pgrep -x kubelet) \$(pgrep -f kube-proxy | head -1) \$(pgrep -f kindnetd | head -1); do printf \"%-14s pid=%-6s oom_score_adj=%s\n\" \$(cat /proc/\$p/comm) \$p \$(cat /proc/\$p/oom_score_adj); done"
