# what a Python program sees on a 4-CPU node (python:3.13-slim pinned to ent-worker)
$ kubectl -n e0-smoke run py --image=python:3.13-slim --restart=Never --overrides="{\"spec\":{\"nodeName\":\"ent-worker\"}}" --command -- python -c "import os; print(\"os.cpu_count() =\", os.cpu_count()); print(\"len(os.sched_getaffinity(0)) =\", len(os.sched_getaffinity(0))); print(\"os.process_cpu_count() =\", os.process_cpu_count())"
pod/py created

$ for i in $(seq 60); do [ "$(kubectl -n e0-smoke get pod py -o jsonpath={.status.phase})" = Succeeded ] && break; sleep 2; done; kubectl -n e0-smoke logs py
os.cpu_count() = 16
len(os.sched_getaffinity(0)) = 4
os.process_cpu_count() = 4

