# Lab overrides for the official OpenTelemetry Demo 3.1.0
# (https://github.com/open-telemetry/opentelemetry-demo, tag 3.1.0).
#
# The release's own .env still points the images at the mutable "latest-*" tags
# (DEMO_VERSION=latest) and reports service.version=3.0.0. Pin both to the release.
# Used as the last --env-file, so these values win:
#   docker compose --env-file .env --env-file <this file> \
#     -f compose.yaml -f compose.observability.yaml -f compose.extras.yaml up -d
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0
# Envoy's admin port defaults to 10000, which a Windows service ("YunDetectService")
# already listens on; with WSL mirrored networking the lab shares Windows' ports.
ENVOY_ADMIN_PORT=10001
