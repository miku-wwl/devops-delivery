# A demo-api pod in prod: where does its process live, and what does the kernel enforce on it?
$ P=$(kubectl -n prod get pods -l app.kubernetes.io/name=demo-api -o jsonpath='{.items[0].metadata.name}'); N=$(kubectl -n prod get pod $P -o jsonpath='{.spec.nodeName}'); C=$(kubectl -n prod get pod $P -o jsonpath='{.status.containerStatuses[0].containerID}'); C=${C#containerd://}; echo "pod=$P node=$N container=${C:0:13}"
pod=demo-api-prod-56ffb56667-gr7cz node=lab-worker container=707e3550e25e4

$ PID=$(docker exec $N crictl inspect $C | jq -r .info.pid); echo "PID of the container's main process, as seen in the node: $PID"
PID of the container's main process, as seen in the node: 29556

# 1. Namespaces. Left: the container process. Right: the node's PID 1. Equal numbers = shared namespace.
$ paste <(docker exec $N readlink /proc/$PID/ns/{cgroup,ipc,mnt,net,pid,user,uts}) <(docker exec $N readlink /proc/1/ns/{cgroup,ipc,mnt,net,pid,user,uts})
cgroup:[4026533181]	cgroup:[4026532585]
ipc:[4026533585]	ipc:[4026532583]
mnt:[4026533179]	mnt:[4026532581]
net:[4026534906]	net:[4026532586]
pid:[4026533180]	pid:[4026532584]
user:[4026531837]	user:[4026531837]
uts:[4026533189]	uts:[4026532582]

$ kubectl -n prod exec $P -- sh -c 'echo "inside the pod, PID 1 is: $(tr "\0" " " < /proc/1/cmdline)"; id'
inside the pod, PID 1 is: /usr/local/bin/python3.13 /usr/local/bin/uvicorn demo_api.main:app --host 0.0.0.0 --port 8080 --no-access-log 
uid=10001(app) gid=10001(app) groups=10001(app)

# 2. Capabilities, no_new_privs and seccomp, as set by the Pod's securityContext; then the node's PID 1 for comparison
$ docker exec $N grep -E '^(Uid|CapEff|CapBnd|NoNewPrivs|Seccomp|Seccomp_filters):' /proc/$PID/status
Uid:	10001	10001	10001	10001
CapEff:	0000000000000000
CapBnd:	0000000000000000
NoNewPrivs:	1
Seccomp:	2
Seccomp_filters:	2

$ docker exec $N grep -E '^CapEff:' /proc/1/status
CapEff:	000001ffffffffff

# 3. cgroup v2: the resources of the Pod spec become kernel limits
$ kubectl -n prod get pod $P -o jsonpath='{.spec.containers[0].resources}{"  qosClass="}{.status.qosClass}{"\n"}'
{"limits":{"cpu":"1","memory":"256Mi"},"requests":{"cpu":"100m","memory":"128Mi"}}  qosClass=Burstable

$ CG=$(docker exec $N cat /proc/$PID/cgroup | cut -d: -f3); echo "cgroup: ...${CG##*/kubelet-kubepods-}"
cgroup: ...burstable-podf640b5aa_7260_4bb9_a58d_53e2600b8e42.slice/cri-containerd-707e3550e25e40d0822c5dcd6ad043715719d0c5b4143c123176e4c2c71d3672.scope

$ for f in memory.max memory.current cpu.max cpu.weight; do echo "$f = $(docker exec $N cat /sys/fs/cgroup$CG/$f)"; done
memory.max = 268435456
memory.current = 62504960
cpu.max = 100000 100000
cpu.weight = 17

# 4. Root filesystem: image layers merged by overlayfs and mounted read-only; /tmp is a separate writable emptyDir volume
