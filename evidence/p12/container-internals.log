$ echo "image layers (lowerdir entries of the root overlay): $(docker exec $N grep ' / ' /proc/$PID/mountinfo | grep -o 'lowerdir=[^,]*' | tr ':' '\n' | wc -l)"
image layers (lowerdir entries of the root overlay): 8

$ kubectl -n prod exec $P -- sh -c 'touch /app/x; touch /tmp/x && echo "/tmp is writable"'
touch: cannot touch '/app/x': Read-only file system
/tmp is writable

# 5. Seccomp in action: add_key(2) needs no capability, but the RuntimeDefault profile blocks it.
$ printf '%s\n' 'import ctypes, os' 'libc = ctypes.CDLL(None, use_errno=True)' 'r = libc.syscall(248, b"user", b"demo", b"x", 1, -3)  # add_key(type, description, payload, len, KEY_SPEC_SESSION_KEYRING)' 'print("add_key ->", "key serial %d (allowed)" % r if r >= 0 else "error: " + os.strerror(ctypes.get_errno()))' > /tmp/addkey.py

$ kubectl -n prod exec -i $P -- python - < /tmp/addkey.py
add_key -> error: Operation not permitted

# Control: the same base image and user on Docker, first without seccomp, then with Docker's default profile
$ docker run --rm -i --user 10001 --security-opt seccomp=unconfined python@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc python - < /tmp/addkey.py
add_key -> key serial 536790600 (allowed)

$ docker run --rm -i --user 10001 python@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc python - < /tmp/addkey.py
add_key -> error: Operation not permitted

