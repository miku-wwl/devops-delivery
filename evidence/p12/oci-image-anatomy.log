# 2. Which parts differ? Layers, compared position by position (= same, x = different)
$ paste <(jq -r '.layers[] | .digest[7:19]' /tmp/manifest-27919359.json) <(jq -r '.layers[] | .digest[7:19]' /tmp/manifest-e17b82f1.json) <(jq -r '.layers[].size' /tmp/manifest-e17b82f1.json) | awk '{printf "layer %d  %s %s  %s  %d bytes\n", NR, $1, $2, ($1==$2 ? "=" : "x"), $3}'
