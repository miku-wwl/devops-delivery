# 3. The config blobs: build history and metadata
$ for D in 27919359 e17b82f1; do CD=$(jq -r .config.digest /tmp/manifest-$D.json); curl -sL -H "Authorization: Bearer $T" "https://ghcr.io/v2/$R/blobs/$CD" -o /tmp/config-$D.json; echo "config of $D: $(sha256sum /tmp/config-$D.json | cut -c1-12)... (declared ${CD:7:12}...)"; done
