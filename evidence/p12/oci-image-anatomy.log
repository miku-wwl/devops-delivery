# 5. Inside layers 7 and 8: same files and contents, different modification times?
$ for D in 27919359 e17b82f1; do for n in 7 8; do L=$(jq -r ".layers[$((n-1))].digest" /tmp/manifest-$D.json); curl -sL -H "Authorization: Bearer $T" "https://ghcr.io/v2/$R/blobs/$L" -o /tmp/layer-$D-$n.tgz; done; done

$ for n in 7 8; do echo "== layer $n: tar listings (permissions, owner, size, mtime, path) of A vs C"; diff <(tar -tvzf /tmp/layer-27919359-$n.tgz) <(tar -tvzf /tmp/layer-e17b82f1-$n.tgz) | head -8; done
