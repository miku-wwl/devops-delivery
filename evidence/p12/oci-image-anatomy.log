# transcript: P12: what a digest is, and why the same commit gave two digests
# recorded: 2026-11-06T19:26:04Z | host: jiejie | user: devops | cwd: /mnt/d/workshop/nov/devops-delivery

# Two images built from the same commit 70ae35c by release runs 42195568852 (A) and 42196846132 (C), chapter 11
$ R=miku-wwl/devops-delivery/demo-api; A=sha256:27919359a4612728dc047402d739252c02dabaa50108eea3ff78cda3825a4dae; C=sha256:e17b82f121c7fa78165acd064dcae8b9c3453d8c4779c4684c99c200fab413c7

$ T=$(curl -s "https://ghcr.io/token?scope=repository:$R:pull" | jq -r .token); echo "anonymous pull token: ${#T} characters"
anonymous pull token: 76 characters

$ for D in $A $C; do curl -s -H "Authorization: Bearer $T" -H "Accept: application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json" "https://ghcr.io/v2/$R/manifests/$D" -o /tmp/manifest-${D:7:8}.json; done

# 1. A digest is the SHA-256 of the manifest bytes - nothing more
$ for D in $A $C; do echo "${D:0:19}...  sha256 of the bytes we received: $(sha256sum /tmp/manifest-${D:7:8}.json | cut -c1-12)..."; done
sha256:27919359a461...  sha256 of the bytes we received: 27919359a461...
sha256:e17b82f121c7...  sha256 of the bytes we received: e17b82f121c7...

$ jq '{schemaVersion, mediaType, config: {mediaType: .config.mediaType, digest: .config.digest[0:19], size: .config.size}, layers: (.layers | length)}' /tmp/manifest-27919359.json
