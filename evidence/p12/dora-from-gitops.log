# Restore time in Git: from the merge of the bad change to the merge of its revert (every environment)
$ git log --first-parent --format='%h %cI %s' origin/main | grep 'revert/' | tac | while read h t rest; do r=$(echo "$rest" | grep -o 'revert/[0-9a-f]*' | cut -d/ -f2); rt=$(git log -1 --format=%cI $r); env=$(git diff --name-only $h^1 $h | head -1 | cut -d/ -f2); echo "$env: $r reverted by $h after $(( $(date -d $t +%s) - $(date -d $rt +%s) )) s"; done
