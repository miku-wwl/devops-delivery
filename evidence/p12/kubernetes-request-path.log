# Part 4. The backend is chosen once per connection. 20 requests over one keep-alive connection, then 20 requests over 20 new connections, sent from a dev pod
$ printf '%s\n' 'import http.client' 'H = "demo-api-prod.prod.svc"' 'c = http.client.HTTPConnection(H, 80)  # one TCP connection, reused by HTTP/1.1 keep-alive' 'for i in range(20):' '    c.request("GET", "/api/v1/info", headers={"X-Request-ID": "p12-keepalive-%d" % i}); c.getresponse().read()' 'c.close()' 'for i in range(20):  # a new TCP connection for every request' '    c = http.client.HTTPConnection(H, 80); c.request("GET", "/api/v1/info", headers={"X-Request-ID": "p12-newconn-%d" % i, "Connection": "close"}); c.getresponse().read(); c.close()' 'print("sent: 20 requests on 1 connection, 20 requests on 20 connections")' > /tmp/conn.py

$ D=$(kubectl -n dev get pods -l app.kubernetes.io/name=demo-api -o jsonpath='{.items[0].metadata.name}'); kubectl -n dev exec -i $D -- python - < /tmp/conn.py
sent: 20 requests on 1 connection, 20 requests on 20 connections

$ sleep 3

$ for p in $(kubectl -n prod get pods -l app.kubernetes.io/name=demo-api -o name); do echo "${p#pod/}: keep-alive=$(kubectl -n prod logs $p --since=3m --tail=-1 | grep -c '"request_id": "p12-keepalive-') new-connections=$(kubectl -n prod logs $p --since=3m --tail=-1 | grep -c '"request_id": "p12-newconn-')"; done
