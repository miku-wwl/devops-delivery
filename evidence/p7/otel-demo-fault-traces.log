# signal 2 - metrics: span metrics generated by the collector, errors per service over 5 minutes
$ curl -s localhost:9090/api/v1/query --data-urlencode 'query=sort_desc(sum by (service_name) (increase(traces_span_metrics_calls_total{status_code="STATUS_CODE_ERROR"}[5m])))' | jq -r '.data.result[] | "\(.metric.service_name): \(.value[1] | tonumber | floor) error spans"' | head -6
