# wait until Jaeger holds failing payment traces
$ for i in $(seq 1 40); do n=$(curl -s 'http://localhost:8080/jaeger/ui/api/traces?service=payment&tags=%7B%22error%22%3A%22true%22%7D&lookback=10m&limit=100' | jq '.data | length'); [ "${n:-0}" -ge 3 ] && break; sleep 6; done; echo "payment traces with error=true in the last 10 min: $n"
payment traces with error=true in the last 10 min: 3

# signal 1 - traces: one failing trace, span by span (service, operation, error message)
$ TID=$(curl -s 'http://localhost:8080/jaeger/ui/api/traces?service=payment&tags=%7B%22error%22%3A%22true%22%7D&lookback=10m&limit=1' | jq -r '.data[0].traceID'); echo "trace: $TID"
trace: 5244d16d21d3d6d814e9f70f7322234c

$ curl -s "http://localhost:8080/jaeger/ui/api/traces/$TID" | jq -r '.data[0] as $t | $t.spans[] | select([.tags[] | select(.key=="error" and .value==true)] | length > 0) | "\($t.processes[.processID].serviceName) | \(.operationName) | \([.logs[].fields[] | select(.key=="exception.message" or .key=="message") | .value] | first // "")"' | head -6
