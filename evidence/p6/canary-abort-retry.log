# transcript: P6 manual abort and retry of the canary
# recorded: 2026-11-06T01:05:50Z | host: jiejie | user: devops | cwd: /mnt/d/workshop/nov/devops-delivery

# k6 only reads its script at start-up: restart it so the new script (no connection reuse) is used
$ kubectl -n loadgen rollout restart deploy/k6
deployment.apps/k6 restarted

$ kubectl -n loadgen rollout status deploy/k6 --timeout=120s
Waiting for deployment "k6" rollout to finish: 1 old replicas are pending termination...
Waiting for deployment "k6" rollout to finish: 1 old replicas are pending termination...
deployment "k6" successfully rolled out

$ for _ in $(seq 1 40); do r=$(curl -s 'http://127.0.0.1:9090/api/v1/query' --data-urlencode 'query=sum(rate(http_requests_total{namespace="prod",role="canary",route=~"/api/.*"}[1m]))' | jq -r '.data.result[0].value[1] // "0"'); awk -v r="$r" 'BEGIN{exit !(r > 1)}' && break; sleep 3; done

$ curl -s 'http://127.0.0.1:9090/api/v1/query' --data-urlencode 'query=sum by (role) (rate(http_requests_total{namespace="prod", route=~"/api/.*"}[1m]))' | jq -r '.data.result[] | "\(.metric.role): \(.value[1] | tonumber | . * 10 | floor / 10) req/s"'
stable: 9 req/s
canary: 1 req/s

# manual abort: the canary is scaled to zero, stable keeps serving
$ kubectl argo rollouts abort demo-api-prod -n prod
rollout 'demo-api-prod' aborted

$ bash delivery/rollouts/watch-rollout.sh prod demo-api-prod Degraded 120
t+1s  phase=Degraded step=0 updated=1 available=5 analysis=- message="RolloutAborted: Rollout aborted update to revision 3"

# retry the same revision with a fresh analysis run
$ kubectl argo rollouts retry rollout demo-api-prod -n prod
rollout 'demo-api-prod' retried

$ bash delivery/rollouts/watch-rollout.sh prod demo-api-prod Paused 300
t+0s  phase=Progressing step=0 updated=0 available=4 analysis=- message="more replicas need to be updated"
t+3s  phase=Progressing step=0 updated=1 available=4 analysis=- message="more replicas need to be updated"
t+9s  phase=Paused step=1 updated=1 available=5 analysis=Running message="CanaryPauseStep"

