$ bash delivery/argocd/promote.sh prod @$PWD/delivery/gitops/patches/prod-rollout.yaml --merge --title "prod: progressive delivery with Argo Rollouts"
 envs/prod/values.yaml | 14 ++++++++++++++
 1 file changed, 14 insertions(+)
@@ -5 +5,15 @@ image:
   digest: sha256:a0a4f18b1749f946d63f8af795f1001e7d06a190f2e70f0adf3e54d7c5ac9c74
+# Progressive delivery for prod: 5 replicas (20% steps = 1 pod), metrics scraped
+# by Prometheus, and a canary with a manual gate after the first step.
+replicaCount: 5
+podMonitor:
+  enabled: true
+rollout:
+  enabled: true
+  steps:
+    - setWeight: 20
+    - pause: {} # manual gate: kubectl argo rollouts promote demo-api-prod -n prod
+    - setWeight: 50
+    - pause: {duration: 60s}
+    - setWeight: 80
+    - pause: {duration: 30s}
