# Error budget of the latency SLO: 1 % of 30 days of prod API requests.
$ RATE=$(curl -s "$P/query" --data-urlencode "query=sum(rate(http_requests_total{namespace=\"prod\", route=~\"/api/.*\"}[1h]))" | jq -r ".data.result[0].value[1]"); echo "prod API requests per second (1h average): $RATE"
prod API requests per second (1h average): 10.293192708033803

$ python3 -c "r=$RATE; budget=r*30*86400*0.01; print(f\"30-day budget: {budget:,.0f} slow requests\"); [print(f\"{name}: {n:,} slow -> {n/budget:.3%} of the budget\") for name, n in ((\"P10 drill (canary, aborted after 72 s)\", 91), (\"P7 incident (poisoned stable pod, 3 h)\", 15662))]"
